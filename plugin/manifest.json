{
  "manifestVersion": 5,
  "id": "com.brunoroli.soundlibrary",
  "name": "Sound Library",
  "version": "0.0.1",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "soundLibraryPanel",
      "label": { "default": "Sound Library" },
      "minimumSize": { "width": 260, "height": 300 },
      "preferredDockedSize": { "width": 320, "height": 500 },
      "preferredFloatingSize": { "width": 320, "height": 500 }
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "request"
  }
}
